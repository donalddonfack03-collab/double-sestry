---
// Squelette commun à toutes les pages : langue, titre, liens vers l'autre langue, en-tête, pied de page.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { langs, switchLang, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Pages internes (guide de style) : à ne pas indexer. */
  noindex?: boolean;
}
const { lang, title, description, noindex = false } = Astro.props;
const current = Astro.url.pathname;
const pageTitle = title === 'Double Sestry' ? title : `${title} · Double Sestry`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#fef7ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c110c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {!noindex && langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(switchLang(current, l), Astro.site)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(switchLang(current, 'fr'), Astro.site)} />}
  </head>
  <body>
    <Header lang={lang} />
    <main id="contenu"><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
