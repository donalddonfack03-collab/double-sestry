---
// Squelette commun à toutes les pages : langue, titre, référencement, aperçus de liens, en-tête, pied de page.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cart from '../components/Cart.astro';
import { langs, switchLang, withBase, type Lang } from '../i18n/ui';
import { ogPath } from '../lib/og';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Pages internes (guide de style) : à ne pas indexer. */
  noindex?: boolean;
  /** Données structurées schema.org (JSON-LD) pour Google et Yandex. */
  jsonLd?: Record<string, unknown>;
  /** Type Open Graph : 'website' par défaut, 'product' pour une fiche produit. */
  ogType?: string;
}
const { lang, title, description, noindex = false, jsonLd, ogType = 'website' } = Astro.props;
const current = Astro.url.pathname;
const pageTitle = title === 'Double Sestry' ? title : `${title} · Double Sestry`;
const canonical = new URL(current, Astro.site).href;
const ogImage = new URL(ogPath(current), Astro.site).href;
const locales: Record<Lang, string> = { fr: 'fr_FR', ru: 'ru_RU' };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fef7ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c110c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(switchLang(current, l), Astro.site)} />)}
        <link rel="alternate" hreflang="x-default" href={new URL(switchLang(current, 'fr'), Astro.site)} />
        <link rel="sitemap" href={withBase('sitemap-index.xml')} />

        <!-- Aperçu du lien sur WhatsApp, Telegram, VK, Facebook… -->
        <meta property="og:site_name" content="Double Sestry" />
        <meta property="og:type" content={ogType} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={title} />
        <meta property="og:locale" content={locales[lang]} />
        {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={locales[l]} />)}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={ogImage} />
      </>
    )}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <Header lang={lang} />
    <main id="contenu"><slot /></main>
    <Footer lang={lang} />
    <Cart lang={lang} />
  </body>
</html>
