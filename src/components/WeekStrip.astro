---
// La semaine type : commandes du lundi au vendredi 20 h 30, cuisine et retraits le week-end.
import type { Lang } from '../i18n/ui';
import { semaine } from '../data/infos';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<ol class="week">
  {semaine.map((j) => (
    <li class={`day day--${j.type}`}>
      <b>{j.jour[lang]}</b>
      <span>{j.quoi[lang]}</span>
    </li>
  ))}
</ol>

<style>
  .week {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 6px;
  }
  .day { border-radius: 12px; padding: 12px 12px 14px; min-width: 0; border: 1px solid var(--line); background: var(--surface); }
  .day b { display: block; font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .day span { display: block; margin-top: 6px; font-size: 0.9rem; line-height: 1.3; font-weight: 600; }
  .day--commande { background: var(--alveole); border-color: transparent; }
  .day--cuisine { background: var(--choco); border-color: var(--choco); color: var(--on-choco); }
  .day--cuisine b { color: var(--miel); }
  @media (max-width: 860px) { .week { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .week { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
