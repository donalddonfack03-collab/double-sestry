---
// Le panier. Le client ajoute des produits, voit le total, puis envoie la commande toute rédigée sur WhatsApp.
// Pas de paiement en ligne : la confirmation se fait sur WhatsApp, puis le client paie par virement.
// Le contenu du panier est gardé dans le navigateur du client (localStorage), rien n'est envoyé ailleurs.
import { enVente } from '../data/produits';
import { contact, retrait } from '../data/infos';
import { path, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const fr = lang === 'fr';

const catalogue = Object.fromEntries(
  enVente.map((p) => [p.slug, { nom: p.nom[lang], formats: p.formats.map((f) => ({ l: f.libelle[lang], p: f.prix })) }]),
);
const textes = fr
  ? {
      bonjour: `${contact.messageParDefaut.fr} ! Je voudrais commander :`,
      total: 'Total',
      retrait: 'Retrait',
      prenom: 'Prénom',
      samedi: 'samedi',
      dimanche: 'dimanche',
      ajoute: 'Ajouté au panier',
      retirer: 'Retirer',
      moins: 'Un de moins',
      plus: 'Un de plus',
    }
  : {
      bonjour: `${contact.messageParDefaut.ru}! Хочу заказать:`,
      total: 'Итого',
      retrait: 'Выдача',
      prenom: 'Имя',
      samedi: 'суббота',
      dimanche: 'воскресенье',
      ajoute: 'Добавлено в корзину',
      retirer: 'Убрать',
      moins: 'На один меньше',
      plus: 'На один больше',
    };
---
<script type="application/json" id="ds-catalogue" set:html={JSON.stringify({ catalogue, textes, whatsapp: contact.whatsapp })} />

<dialog class="cart" id="ds-cart" aria-labelledby="ds-cart-title">
  <div class="cart__in">
    <header class="cart__head">
      <h2 id="ds-cart-title">{fr ? 'Mon panier' : 'Моя корзина'}</h2>
      <button class="x" type="button" data-cart-close aria-label={fr ? 'Fermer' : 'Закрыть'}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </header>

    <div class="empty" data-cart-empty>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2.2l2.1 10.2a1.6 1.6 0 0 0 1.6 1.3h8.4a1.6 1.6 0 0 0 1.6-1.2L20.5 8H6.1" /><circle cx="10" cy="19.5" r="1.4" /><circle cx="17" cy="19.5" r="1.4" /></svg>
      <p>{fr ? 'Votre panier est vide.' : 'Корзина пуста.'}</p>
      <a class="btn btn--main" href={path(lang, 'carte')}>{fr ? 'Voir la carte' : 'Смотреть меню'}</a>
    </div>

    <ul class="lines" data-cart-lines></ul>

    <div class="foot" data-cart-foot>
      <div class="total"><span>{textes.total}</span><b data-cart-total>0 ₽</b></div>
      <fieldset class="day">
        <legend>{fr ? 'Jour de retrait' : 'День выдачи'}</legend>
        <label><input type="radio" name="ds-jour" value="samedi" checked /><span>{fr ? 'Samedi' : 'Суббота'}<small>8:00 – 20:00</small></span></label>
        <label><input type="radio" name="ds-jour" value="dimanche" /><span>{fr ? 'Dimanche' : 'Воскресенье'}<small>8–10, 15–21</small></span></label>
      </fieldset>
      <label class="name">
        <span>{fr ? 'Votre prénom (on l’écrit sur le sac)' : 'Ваше имя (напишем на пакете)'}</span>
        <input type="text" name="ds-prenom" autocomplete="given-name" maxlength="40" />
      </label>
      <a class="btn btn--main send" data-cart-send href="#" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 20.5l1.6-5.4A8.4 8.4 0 1 1 21 11.5z" /></svg>
        {fr ? 'Envoyer sur WhatsApp' : 'Отправить в WhatsApp'}
      </a>
      <p class="hint">
        {fr
          ? `Rien n’est payé ici. On vous répond sous 2 h avec le total, puis vous payez par virement pour valider. Commandes jusqu’au ${retrait.finCommandes.fr}.`
          : `Здесь ничего не оплачивается. В течение 2 часов пришлём сумму, затем оплата переводом подтверждает заказ. Заказы до ${retrait.finCommandes.ru}.`}
      </p>
    </div>
  </div>
</dialog>

<div class="toast" data-cart-toast role="status" aria-live="polite"></div>

<script>
  type Ligne = { s: string; f: number; q: number };
  const data = JSON.parse(document.getElementById('ds-catalogue')!.textContent!);
  const { catalogue, textes, whatsapp } = data;
  const KEY = 'ds-panier';
  const dlg = document.getElementById('ds-cart') as HTMLDialogElement;
  const $ = <T extends Element>(s: string) => dlg.querySelector(s) as T;
  const prix = (n: number) => `${n.toLocaleString('fr-FR').replace(/\s/g, ' ')} ₽`;

  function lire(): Ligne[] {
    try {
      const v = JSON.parse(localStorage.getItem(KEY) || '[]');
      return Array.isArray(v) ? v.filter((l) => catalogue[l.s]?.formats[l.f]?.p != null && l.q > 0) : [];
    } catch { return []; }
  }
  let panier: Ligne[] = lire();
  function garder() { try { localStorage.setItem(KEY, JSON.stringify(panier)); } catch {} }

  function total() { return panier.reduce((t, l) => t + catalogue[l.s].formats[l.f].p * l.q, 0); }
  function nombre() { return panier.reduce((t, l) => t + l.q, 0); }

  function message() {
    const jour = ($<HTMLInputElement>('input[name="ds-jour"]:checked')?.value === 'dimanche') ? textes.dimanche : textes.samedi;
    const prenom = $<HTMLInputElement>('input[name="ds-prenom"]').value.trim();
    const lignes = panier.map((l) => {
      const p = catalogue[l.s]; const f = p.formats[l.f];
      const fmt = p.formats.length > 1 ? ` (${f.l})` : '';
      return `• ${l.q} × ${p.nom}${fmt} : ${prix(f.p * l.q)}`;
    });
    return [textes.bonjour, ...lignes, '', `${textes.total} : ${prix(total())}`, `${textes.retrait} : ${jour}`, prenom ? `${textes.prenom} : ${prenom}` : '']
      .filter((x, i, a) => !(x === '' && i === a.length - 1)).join('\n');
  }

  function rendre() {
    const n = nombre();
    document.querySelectorAll('[data-cart-count]').forEach((el) => {
      el.textContent = String(n);
      (el as HTMLElement).hidden = n === 0;
    });
    ($<HTMLElement>('[data-cart-empty]')).hidden = n > 0;
    ($<HTMLElement>('[data-cart-foot]')).hidden = n === 0;
    const ul = $<HTMLUListElement>('[data-cart-lines]');
    ul.replaceChildren(...panier.map((l, i) => {
      const p = catalogue[l.s]; const f = p.formats[l.f];
      const li = document.createElement('li');
      li.innerHTML = `
        <div class="l__txt"><b></b><small></small></div>
        <div class="qty">
          <button type="button" data-d="-1" aria-label="${textes.moins}">−</button>
          <span aria-live="polite"></span>
          <button type="button" data-d="1" aria-label="${textes.plus}">+</button>
        </div>
        <b class="l__prix"></b>`;
      li.querySelector('.l__txt b')!.textContent = p.nom;
      li.querySelector('.l__txt small')!.textContent = `${f.l} · ${prix(f.p)}`;
      li.querySelector('.qty span')!.textContent = String(l.q);
      li.querySelector('.l__prix')!.textContent = prix(f.p * l.q);
      li.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => {
        l.q += Number(b.dataset.d);
        if (l.q <= 0) panier.splice(i, 1);
        garder(); rendre();
      }));
      return li;
    }));
    $<HTMLElement>('[data-cart-total]').textContent = prix(total());
    majLien();
  }
  function majLien() {
    $<HTMLAnchorElement>('[data-cart-send]').href = `https://wa.me/${whatsapp}?text=${encodeURIComponent(message())}`;
  }
  dlg.addEventListener('input', majLien);
  dlg.addEventListener('change', majLien);

  let tTimer: number | undefined;
  function toast(txt: string) {
    const el = document.querySelector('[data-cart-toast]') as HTMLElement;
    el.textContent = txt; el.classList.add('on');
    clearTimeout(tTimer); tTimer = window.setTimeout(() => el.classList.remove('on'), 2200);
  }

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const add = t.closest<HTMLElement>('[data-add]');
    if (add) {
      e.preventDefault();
      const s = add.dataset.add!; const f = Number(add.dataset.f || 0);
      const l = panier.find((x) => x.s === s && x.f === f);
      if (l) l.q += 1; else panier.push({ s, f, q: 1 });
      garder(); rendre();
      toast(`${textes.ajoute} · ${catalogue[s].nom}`);
      add.classList.remove('pop'); void add.offsetWidth; add.classList.add('pop');
      return;
    }
    if (t.closest('[data-cart-open]')) { e.preventDefault(); rendre(); dlg.showModal(); return; }
    if (t.closest('[data-cart-close]') || t === dlg) dlg.close();
  });
  window.addEventListener('storage', (e) => { if (e.key === KEY) { panier = lire(); rendre(); } });
  rendre();
</script>

<style>
  .cart {
    margin: 0 0 0 auto; height: 100dvh; max-height: 100dvh; width: min(440px, 100vw); max-width: 100vw;
    padding: 0; border: 0; background: var(--creme); color: var(--ink);
    box-shadow: -20px 0 60px rgb(42 20 8 / 0.25);
  }
  .cart::backdrop { background: rgb(28 17 12 / 0.45); }
  .cart[open] { animation: slide 0.28s cubic-bezier(.2,.8,.2,1); }
  @keyframes slide { from { transform: translateX(40px); opacity: 0; } }
  .cart__in { display: flex; flex-direction: column; height: 100%; }
  .cart__head { display: flex; align-items: center; justify-content: space-between; padding: 18px 22px; border-bottom: 1px solid var(--line); }
  .cart__head h2 { font-size: var(--step-2); }
  .x { width: 40px; height: 40px; border-radius: 50%; border: 0; background: var(--alveole); cursor: pointer; display: grid; place-items: center; color: var(--choco); }
  .x svg { width: 18px; height: 18px; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; fill: none; }
  .empty { flex: 1; display: grid; place-content: center; justify-items: center; gap: 14px; padding: 24px; text-align: center; color: var(--muted); }
  .empty svg { width: 56px; height: 56px; stroke: var(--miel); stroke-width: 1.6; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .empty[hidden], .foot[hidden] { display: none; }
  .lines { list-style: none; margin: 0; padding: 6px 22px; flex: 1; overflow-y: auto; }
  .lines :global(li) { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 12px; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .lines :global(.l__txt) { display: grid; min-width: 0; }
  .lines :global(.l__txt b) { color: var(--choco); font-weight: 750; }
  .lines :global(.l__txt small) { color: var(--muted); font-size: 0.82rem; }
  .lines :global(.qty) { display: flex; align-items: center; border: 1.5px solid var(--line); border-radius: 999px; }
  .lines :global(.qty button) { width: 32px; height: 32px; border: 0; background: none; font-size: 1.1rem; font-weight: 700; color: var(--choco); cursor: pointer; border-radius: 50%; }
  .lines :global(.qty button:hover) { background: var(--alveole); }
  .lines :global(.qty span) { min-width: 20px; text-align: center; font-weight: 750; font-variant-numeric: tabular-nums; }
  .lines :global(.l__prix) { min-width: 64px; text-align: right; font-variant-numeric: tabular-nums; color: var(--choco); }
  .foot { padding: 16px 22px calc(18px + env(safe-area-inset-bottom)); border-top: 1px solid var(--line); background: var(--surface); display: grid; gap: 14px; }
  .total { display: flex; justify-content: space-between; align-items: baseline; font-weight: 700; }
  .total b { font-size: 1.6rem; font-weight: 850; color: var(--choco); font-variant-numeric: tabular-nums; }
  .day { border: 0; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .day legend { font-size: 0.8rem; font-weight: 700; color: var(--muted); margin-bottom: 6px; padding: 0; }
  .day label { position: relative; cursor: pointer; }
  .day input { position: absolute; opacity: 0; }
  .day span { display: grid; border: 1.5px solid var(--line); border-radius: 10px; padding: 8px 12px; font-weight: 700; color: var(--choco); }
  .day small { font-weight: 500; color: var(--muted); font-size: 0.78rem; }
  .day input:checked + span { border-color: var(--choco); box-shadow: inset 0 0 0 1px var(--choco); background: var(--alveole); }
  .day input:focus-visible + span { outline: 2.5px solid var(--miel); outline-offset: 2px; }
  .name { display: grid; gap: 6px; font-size: 0.8rem; font-weight: 700; color: var(--muted); }
  .name input { font: inherit; font-size: 1rem; font-weight: 500; color: var(--ink); background: var(--creme); border: 1.5px solid var(--line); border-radius: 10px; padding: 10px 12px; }
  .name input:focus { outline: none; border-color: var(--miel); }
  .send { justify-content: center; padding-block: 1em; }
  .hint { font-size: 0.78rem; color: var(--muted); text-align: center; }

  .toast {
    position: fixed; left: 50%; bottom: 24px; z-index: 60;
    transform: translate(-50%, 20px); opacity: 0; pointer-events: none;
    background: var(--choco); color: var(--on-choco); font-weight: 700; font-size: 0.92rem;
    padding: 12px 18px; border-radius: 999px; box-shadow: 0 10px 30px rgb(0 0 0 / 0.25);
    transition: opacity 0.2s, transform 0.2s; max-width: calc(100vw - 32px); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .toast:global(.on) { opacity: 1; transform: translate(-50%, 0); }
</style>
