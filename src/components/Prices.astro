---
// Les formats et prix d'un produit, en pastilles.
import { t, type Lang } from '../i18n/ui';
import { prix, type Format } from '../data/produits';

interface Props { lang: Lang; formats: Format[]; size?: 'md' | 'lg'; depuis?: boolean }
const { lang, formats, size = 'md', depuis = false } = Astro.props;
---
<ul class:list={['prices', `prices--${size}`]}>
  {formats.map((f) => (
    <li>
      <span class="label">{f.libelle[lang]}</span>
      {f.prix === null ? (
        <strong>{t(lang, 'produit.surDevis')}</strong>
      ) : (
        <strong>{depuis && (lang === 'fr' ? 'dès ' : 'от ')}{prix(f.prix)}</strong>
      )}
      {f.prixBarre && <s aria-label={`${t(lang, 'produit.auLieuDe')} ${prix(f.prixBarre)}`}>{prix(f.prixBarre)}</s>}
    </li>
  ))}
</ul>

<style>
  .prices { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  li {
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 0.45em 0.95em;
    font-variant-numeric: tabular-nums;
  }
  .label { color: var(--muted); font-size: 0.86em; }
  strong { font-weight: 750; color: var(--choco); }
  s { color: var(--muted); font-size: 0.86em; }
  .prices--lg li { font-size: 1.08rem; padding: 0.55em 1.1em; }
</style>
