---
// Une alvéole : photo optimisée (WebP, plusieurs tailles) ou, sans photo, une alvéole miel avec un mot.
import { Image } from 'astro:assets';
import Mark from './Mark.astro';
import type { ImageMetadata } from 'astro';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp}', { eager: true });

interface Props {
  /** Nom du fichier dans src/assets/photos/ */
  photo?: string;
  alt?: string;
  /** Texte affiché quand il n'y a pas de photo (sinon : l'abeille). */
  label?: string;
  /** Largeur maximale affichée, pour choisir les bonnes tailles d'image. */
  width?: number;
  tone?: 'miel' | 'alveole' | 'choco';
  loading?: 'lazy' | 'eager';
  class?: string;
}
const { photo, alt = '', label, width = 360, tone = 'miel', loading = 'lazy', class: cls } = Astro.props;
const src = photo ? photos[`../assets/photos/${photo}`]?.default : undefined;
---
<div class:list={['hex', 'hex-shape', `hex--${src ? 'photo' : tone}`, cls]} style={`--w:${width}px`}>
  {src ? (
    <Image src={src} alt={alt} widths={[width, Math.round(width * 1.5), width * 2]} sizes={`(max-width: 640px) 60vw, ${width}px`} loading={loading} format="webp" quality={80} />
  ) : (
    label ? <span>{label}</span> : <Mark size="46%" />
  )}
</div>

<style>
  .hex {
    width: 100%;
    max-width: var(--w);
    aspect-ratio: 1 / 1.1547;
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .hex :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .hex--photo { background: var(--alveole); }
  .hex--miel { background: var(--miel); color: var(--on-miel); }
  .hex--alveole { background: var(--alveole); color: var(--choco); }
  .hex--choco { background: var(--choco); color: var(--on-choco); }
  .hex span {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: clamp(1.1rem, 0.9rem + 1.2vw, 2rem);
    text-align: center;
    padding: 18%;
    line-height: 1.1;
  }
</style>
