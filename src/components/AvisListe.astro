---
// Cartes d'avis clients (vrais messages WhatsApp), sur trois colonnes en grand écran.
import Etoiles from './Etoiles.astro';
import type { Avis } from '../data/avis';
import type { Lang } from '../i18n/ui';
interface Props { avis: Avis[]; lang: Lang }
const { avis, lang } = Astro.props;
---
<ul class="liste">
  {avis.map((a) => (
    <li class="carte">
      {typeof a.note === 'number' && <Etoiles note={a.note} lang={lang} />}
      <blockquote lang={lang}><p>« {a.texte[lang]} »</p></blockquote>
      <p class="qui">
        {a.prenom && <strong>{a.prenom}</strong>}
        {a.contexte && <span>{a.contexte[lang]}</span>}
      </p>
    </li>
  ))}
</ul>
<style>
  .liste { list-style: none; margin: 0; padding: 0; columns: 3 300px; column-gap: var(--space-5); }
  .carte { break-inside: avoid; margin: 0 0 var(--space-5); display: grid; gap: var(--space-3); background: var(--surface); border-radius: 22px; padding: var(--space-5); border-top: 4px solid var(--miel); }
  blockquote { margin: 0; }
  blockquote p { font-family: var(--font-display); color: var(--choco); font-size: 1.12rem; line-height: 1.5; }
  .qui { display: grid; gap: 2px; font-size: 0.92rem; }
  .qui span { color: var(--muted); }
</style>
