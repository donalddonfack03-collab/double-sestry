---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Tuile from '../../components/Tuile.astro';
import { langPaths, t, path, type Lang } from '../../i18n/ui';
import { marque, retrait, lienWhatsApp, messageBox, parcours, reponse } from '../../data/infos';
import { trouver, type Produit } from '../../data/produits';
import { accroche, promesses } from '../../data/histoire';
import { avis, moyenne, nombreNotes } from '../../data/avis';
import AvisListe from '../../components/AvisListe.astro';
import Etoiles from '../../components/Etoiles.astro';
import { etablissement } from '../../lib/schema';
import table from '../../assets/photos/table.jpg';
import sac from '../../assets/photos/sac.jpg';
import soeursPhoto from '../../assets/photos/soeurs.jpg';
import boxBurgers from '../../assets/photos/box-burgers.jpg';
import boxMix from '../../assets/photos/box-mix.jpg';
import gateauCitron from '../../assets/photos/gateau-citron.jpg';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const fr = lang === 'fr';
const produitsPhares = ['la-sestry', 'la-choco', 'lotus', 'pastels', 'bissap'].map(trouver).filter((p): p is Produit => !!p);
const formules = ['grande-faim', 'douceur-complete', 'mini-douceur'].map(trouver).filter((p): p is Produit => !!p);
const badges: Record<string, { fr: string; ru: string }> = {
  'la-sestry': { fr: 'Signature', ru: 'Фирменный' },
};

// L'expérience client : les trois promesses de la maison, et une vraie personne au bout du fil.
const [frais, pareil, prenom] = promesses;
const experience = [
  prenom,
  frais,
  pareil,
  {
    titre: { fr: 'Une vraie personne vous répond', ru: 'Вам отвечает живой человек' },
    texte: {
      fr: `Ria ou Emma, sur WhatsApp, en français ou en russe. ${reponse.fr}`,
      ru: `Рия или Эмма — в WhatsApp, по-русски или по-французски. ${reponse.ru}`,
    },
  },
];

const etapes = parcours.map((e) => ({ t: e.titre[lang], d: e.texte[lang] }));
---
<Base
  lang={lang}
  title={marque.nomComplet}
  jsonLd={etablissement(lang, Astro.site!)}
  description={fr
    ? 'Crêpes, pastels et bissap faits maison par deux sœurs de Pointe-Noire, à Briansk. Le week-end, sur commande, retrait devant la cité.'
    : 'Блины, пастели и биссап от двух сестёр из Пуэнт-Нуара, в Брянске. По выходным, под заказ, выдача у общежития.'}
>
  <!-- 1. Accueil : la photo et une promesse en très grand -->
  <section class="hero">
    <div class="hero__pic">
      <Image src={table} alt={fr ? 'Plateau de crêpes salées, de pastels et de crêpes au chocolat avec du bissap' : 'Поднос: солёные блины, пастели, шоколадные блины и биссап'} widths={[480, 720, 1000, 1254]} sizes="(max-width: 860px) 100vw, 50vw" loading="eager" fetchpriority="high" format="webp" quality={82} />
    </div>
    <div class="hero__text">
      <p class="hero__eyebrow">{fr ? 'Fait maison' : 'Домашняя кухня'} · {marque.ville[lang]}</p>
      <h1>
        {fr ? 'La semaine est chargée.' : 'Будни трудные.'}
        <em>{fr ? <>Le <span class="nowrap">week-end</span> sera doux.</> : 'Выходные\u00a0— вкусные.'}</em>
      </h1>
      <p class="hero__lead">
        {fr
          ? 'Crêpes, pastels et bissap faits sur commande par deux sœurs.'
          : 'Блины, пастели и биссап под заказ от двух сестёр.'}
      </p>
      <div class="cta">
        <a class="btn btn--miel btn--xl" href="#douceurs">{fr ? 'Choisir mes douceurs' : 'Выбрать вкусное'}</a>
        <a class="hero__link" href={path(lang, 'carte')}>{t(lang, 'cta.voirCarte')} <span aria-hidden="true">→</span></a>
      </div>
      <p class="hero__facts">{fr ? 'Dès 120 ₽ la crêpe · Retrait samedi et dimanche' : 'Блины от 120 ₽ · Выдача в субботу и воскресенье'}</p>
    </div>
  </section>

  <!-- 2. Toute l'offre d'un coup d'œil : une couleur par produit -->
  <section class="wrap section" id="douceurs">
    <div class="titre">
      <h2>{fr ? 'Choisissez votre douceur' : 'Выберите своё вкусное'}</h2>
      <a class="more" href={path(lang, 'carte')}>{fr ? 'Toute la carte' : 'Всё меню'} <span aria-hidden="true">→</span></a>
    </div>
    <div class="grille">
      {produitsPhares.map((p, i) => <Tuile lang={lang} produit={p} taille={i === 0 ? 'grande' : 'normale'} badge={badges[p.slug]?.[lang]} loading={i === 0 ? 'eager' : 'lazy'} />)}
    </div>
  </section>

  <!-- 3. Les formules -->
  <section class="wrap" id="formules">
    <div class="titre">
      <h2>{fr ? 'Les formules' : 'Наборы'}</h2>
    </div>
    <div class="formules">
      {formules.map((p) => <Tuile lang={lang} produit={p} taille="formule" />)}
    </div>
  </section>

  <!-- 4. L'expérience client -->
  <section class="wrap section experience" id="experience">
    <div class="experience__pic">
      <Image src={sac} alt={fr ? 'Deux sacs de commande avec « Bon appétit » et le prénom du client écrits à la main' : 'Два пакета с заказами, на которых от руки написано «Приятного аппетита» и имя клиента'} widths={[400, 640, 800]} sizes="(max-width: 860px) 100vw, 40vw" format="webp" quality={80} />
    </div>
    <div class="experience__txt">
      <p class="eyebrow">{fr ? 'Commander chez nous' : 'Заказ у нас'}</p>
      <h2>{fr ? 'Une commande préparée comme pour la famille.' : 'Заказ, приготовленный как для своих.'}</h2>
      <p class="experience__lead">
        {fr
          ? 'Pas de stock, pas de vitrine : chaque commande est préparée pour une personne, avec son prénom.'
          : 'Никаких запасов и витрин: каждый заказ готовится для конкретного человека — с его именем.'}
      </p>
      <ul class="experience__liste">
        {experience.map((e) => (
          <li><h3>{e.titre[lang]}</h3><p>{e.texte[lang]}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4 bis. Ce que disent les clients (vrais messages WhatsApp) -->
  <section class="wrap section avis" id="avis">
    <div class="avis__head">
      <p class="eyebrow">{fr ? 'Ils ont goûté' : 'Уже попробовали'}</p>
      <h2>{fr ? 'Ce qu’ils nous ont écrit.' : 'Что нам написали.'}</h2>
      {nombreNotes > 0 && (
        <p class="avis__score"><Etoiles note={moyenne} lang={lang} taille="1.3rem" /> <b>{String(moyenne).replace('.', ',')}/5</b></p>
      )}
      <p class="avis__note">
        {fr
          ? 'Extraits de messages reçus sur WhatsApp après livraison.'
          : 'Отрывки из сообщений в WhatsApp после получения заказа. Перевод с французского.'}
      </p>
    </div>
    <AvisListe avis={avis.slice(0, 3)} lang={lang} />
    <a class="more" href={path(lang, 'avis')}>{fr ? `Voir tous les avis (${avis.length}) →` : `Все отзывы (${avis.length}) →`}</a>
  </section>

  <!-- 4 ter. Anniversaires -->
  <section class="wrap section" id="anniversaires">
    <div class="anniv">
      <div class="anniv__pics">
        <Image class="p1" src={boxBurgers} alt={fr ? 'Box anniversaire : mini-burgers, wraps et mini hot-dogs' : 'Праздничный бокс: мини-бургеры, роллы и мини хот-доги'} widths={[400, 600, 800]} sizes="(max-width: 860px) 60vw, 30vw" format="webp" quality={78} />
        <Image class="p2" src={boxMix} alt={fr ? 'Box de feuilletés, gâteau marbré et mini-pizzas' : 'Бокс со слойками, мраморным кексом и мини-пиццами'} widths={[300, 500]} sizes="(max-width: 860px) 40vw, 18vw" format="webp" quality={76} />
        <Image class="p3" src={gateauCitron} alt={fr ? 'Gâteau au citron coupé en tranches' : 'Лимонный кекс, нарезанный ломтиками'} widths={[300, 500]} sizes="(max-width: 860px) 40vw, 18vw" format="webp" quality={76} />
      </div>
      <div class="anniv__txt">
        <p class="eyebrow">{fr ? 'Anniversaires et fêtes' : 'Дни рождения и праздники'}</p>
        <h2>{fr ? 'La box d’anniversaire, composée par vous.' : 'Праздничный бокс, который собираете вы.'}</h2>
        <ul class="checks">
          <li><span>{fr ? 'Vous choisissez les produits : mini-burgers, wraps, mini hot-dogs, pastels, crêpes, feuilletés…' : 'Выбираете блюда: мини-бургеры, роллы, мини хот-доги, пастели, блины, слойки…'}</span></li>
          <li><span>{fr ? 'Pour le nombre de personnes que vous voulez.' : 'На нужное количество гостей.'}</span></li>
          <li><span>{fr ? 'Avec le prénom et le message de votre choix.' : 'С именем и надписью на ваш выбор.'}</span></li>
          <li><span>{fr ? <>Et un gâteau maison si vous voulez : marbré, citron ou yaourt, <b>dès 700 ₽</b>.</> : <>И домашний кекс по желанию: мраморный, лимонный или йогуртовый, <b>от 700 ₽</b>.</>}</span></li>
        </ul>
        <p class="anniv__note">{fr ? 'À commander au moins 48 h à l’avance. On vous donne le prix selon votre composition.' : 'Заказ минимум за 48 часов. Цену назовём по вашему составу.'}</p>
        <div class="cta">
          <a class="btn btn--main" href={lienWhatsApp(messageBox[lang])} target="_blank" rel="noopener">{fr ? 'Composer ma box sur WhatsApp' : 'Собрать бокс в WhatsApp'}</a>
          <a class="more" href={path(lang, 'carte/gateaux')}>{fr ? 'Les gâteaux' : 'Кексы'} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Comment ça marche -->
  <section class="wrap section">
    <div class="titre titre--centre">
      <p class="eyebrow">{fr ? 'Comment ça marche' : 'Как это работает'}</p>
      <h2>{fr ? 'Commander en 4 étapes' : 'Заказ в 4 шага'}</h2>
    </div>
    <ol class="etapes">
      {etapes.map((e, i) => (
        <li>
          <span class="num" aria-hidden="true">{i + 1}</span>
          <h3>{e.t}</h3>
          <p>{e.d}</p>
        </li>
      ))}
    </ol>
    <p class="forme"><a class="btn btn--ghost" href="#douceurs">{fr ? 'Choisir mes douceurs' : 'Выбрать вкусное'}</a></p>
  </section>

  <!-- 6. L'histoire -->
  <section class="histoire">
    <div class="wrap histoire__grid">
      <div class="histoire__pic">
        <Image src={soeursPhoto} alt={fr ? 'Les deux sœurs de Double Sestry, en tablier, dans leur cuisine' : 'Две сестры Double Sestry в фартуках у себя на кухне'} widths={[400, 640, 800]} sizes="(max-width: 860px) 100vw, 40vw" format="webp" quality={82} />
      </div>
      <div class="histoire__txt">
        <p class="eyebrow">{t(lang, 'nav.histoire')}</p>
        <h2>{accroche.titre[lang]}</h2>
        <p>{accroche.texte[lang]}</p>
        <a class="btn btn--ghost" href={path(lang, 'histoire')}>{fr ? 'Lire leur histoire' : 'Читать их историю'}</a>
      </div>
    </div>
  </section>

  <!-- 8. Dernier appel -->
  <section class="wrap">
    <div class="band">
      <div>
        <h2 class="si-ouvert">{fr ? `Commandes ouvertes jusqu’au ${retrait.finCommandes.fr}.` : `Заказы принимаем до ${retrait.finCommandes.ru}.`}</h2>
        <h2 class="si-clos">{fr ? 'Une envie de dernière minute ? Écrivez-nous, selon disponibilité.' : 'Хотите заказать в последний момент? Напишите нам — по наличию.'}</h2>
        <p>{retrait.prevenir[lang]}</p>
      </div>
      <a class="btn btn--miel btn--xl" href="#douceurs">{fr ? 'Choisir mes douceurs' : 'Выбрать вкусное'}</a>
    </div>
  </section>
</Base>

<style>
  .nowrap { white-space: nowrap; }
  .cta { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-5); align-items: center; }
  .btn--xl { padding: 1.05em 1.7em; font-size: 1.08rem; font-weight: 850; }
  .more { font-weight: 800; color: var(--choco); text-decoration: none; white-space: nowrap; }
  .more:hover { text-decoration: underline; }

  /* 1. Accueil : un grand aplat chocolat et la photo. Les couleurs sont fixes, de jour comme de nuit. */
  .hero { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); min-height: min(86vh, 780px); background: #4a1a0f; color: #fef3e2; }
  .hero__text {
    display: grid; gap: var(--space-5); align-content: center; min-width: 0;
    padding: var(--space-7) clamp(24px, 4vw, 64px) var(--space-7) clamp(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter)), 160px);
  }
  .hero__eyebrow { font-size: 0.82rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: #f4c65d; }
  .hero h1 { color: #fef3e2; font-size: clamp(2.7rem, 0.6rem + 5.2vw, 6rem); line-height: 1; letter-spacing: -0.015em; }
  .hero h1 em { display: block; font-style: normal; color: #f2b247; }
  .hero__lead { font-size: var(--step-1); max-width: 32ch; line-height: 1.45; }
  .hero__link { font-weight: 800; text-underline-offset: 0.3em; }
  .hero__facts { font-size: 0.92rem; font-weight: 650; opacity: 0.85; }
  .hero__pic { order: 2; position: relative; min-height: 420px; overflow: hidden; }
  .hero__pic :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 18%; }

  /* 2 et 3. Grilles de produits */
  .titre { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--space-3); margin-bottom: var(--space-6); }
  .titre h2 { font-size: clamp(2.2rem, 1.2rem + 3.4vw, 4.2rem); line-height: 1; }
  .titre--centre { flex-direction: column; align-items: center; text-align: center; }
  .grille { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .grille > :global(:first-child) { grid-column: 1 / -1; }
  .formules { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }


  /* 4. Anniversaires */
  .anniv { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); align-items: center; background: #8a1538; color: #fff0f3; border-radius: 28px; padding: clamp(14px, 3vw, 36px); }
  .anniv__pics { display: grid; grid-template-columns: 1.25fr 1fr; grid-template-rows: minmax(0, 1fr) minmax(0, 1fr); gap: 10px; aspect-ratio: 1; }
  .anniv__pics :global(img) { width: 100%; height: 100%; object-fit: cover; border-radius: 16px; min-height: 0; }
  .anniv__pics :global(.p1) { grid-row: span 2; }
  .anniv__txt { display: grid; gap: var(--space-4); align-content: center; padding: 6px clamp(4px, 2vw, 24px) 10px; }
  .anniv .eyebrow { color: #ffc9d5; }
  .anniv h2 { color: #fff0f3; font-size: clamp(2rem, 1.3rem + 2.4vw, 3.4rem); }
  .checks { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .checks li { display: grid; grid-template-columns: 12px 1fr; gap: 12px; line-height: 1.45; }
  .checks li::before { content: ''; width: 12px; height: 14px; margin-top: 5px; background: #f4c65d; clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%); }
  .anniv__note { font-size: 0.9rem; opacity: 0.85; }
  .anniv .btn--main { background: #fff0f3; color: #8a1538; }
  .anniv .more { color: #fff0f3; }

  /* 5. Étapes */
  .etapes { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .etapes li { background: #f4c65d; color: #2a1408; border-radius: 22px; padding: clamp(20px, 2.4vw, 30px); display: grid; gap: var(--space-2); align-content: start; }
  .num { font-family: var(--font-display); font-size: 4.2rem; line-height: 0.9; margin-bottom: var(--space-3); }
  .etapes h3 { color: #2a1408; font-size: var(--step-1); }
  .etapes p { font-size: 0.95rem; }
  .forme { display: flex; justify-content: center; margin-top: var(--space-6); }

  /* 6. Histoire */
  .histoire { background: var(--alveole); padding-block: var(--space-8); }
  .histoire__grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(28px, 6vw, 80px); align-items: center; }
  .histoire__pic { aspect-ratio: 4 / 5; border-radius: 28px; overflow: hidden; max-height: 620px; }
  .histoire__pic :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; }
  .histoire__txt { display: grid; gap: var(--space-5); justify-items: start; }
  .histoire__txt h2 { font-size: clamp(2rem, 1.3rem + 2.4vw, 3.4rem); }
  .histoire__txt p { font-size: var(--step-1); line-height: 1.55; max-width: 46ch; }

  /* 7. Promesses */
  .avis { display: grid; gap: var(--space-6); }
  .avis__head { display: grid; gap: var(--space-3); max-width: 46ch; }
  .avis h2 { font-size: clamp(2rem, 1.3rem + 2.4vw, 3.4rem); }
  .avis__note { color: var(--muted); }
  .avis .more { justify-self: start; margin-top: calc(-1 * var(--space-3)); }
  .avis__score { display: flex; align-items: center; gap: var(--space-2); color: var(--choco); }
  .experience { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(28px, 5vw, 72px); align-items: center; }
  .experience__pic { aspect-ratio: 4 / 5; border-radius: 28px; overflow: hidden; max-height: 640px; }
  .experience__pic :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 78%; }
  .experience__txt { display: grid; gap: var(--space-4); }
  .experience h2 { font-size: clamp(2rem, 1.3rem + 2.4vw, 3.4rem); }
  .experience__lead { font-size: var(--step-1); line-height: 1.5; max-width: 44ch; }
  .experience__liste { list-style: none; margin: var(--space-3) 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5) clamp(20px, 3vw, 40px); }
  .experience__liste li { display: grid; gap: var(--space-2); align-content: start; border-top: 4px solid var(--miel); padding-top: var(--space-3); }
  .experience__liste h3 { font-size: var(--step-1); }
  .experience__liste p { color: var(--muted); font-size: 0.95rem; line-height: 1.5; }

  /* 8. Dernier appel */
  .band { display: flex; flex-wrap: wrap; gap: var(--space-5); align-items: center; justify-content: space-between; background: #4a1a0f; color: #fef3e2; border-radius: 28px; padding: clamp(28px, 5vw, 64px); }
  .band h2 { color: #fef3e2; font-size: clamp(2rem, 1.3rem + 2.4vw, 3.4rem); }
  .band p { margin-top: var(--space-3); opacity: 0.85; }
  .band > div { min-width: 0; flex: 1 1 320px; }

  @media (max-width: 1000px) {
    .grille { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .formules { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .formules > :global(:first-child) { grid-column: span 2; }
    .etapes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 860px) {
    /* Sur téléphone : la photo des plats reste dégagée, le titre et le bouton sont juste dessous. */
    .hero { grid-template-columns: minmax(0, 1fr); grid-template-rows: minmax(230px, 1fr) auto; min-height: calc(100svh - 112px); }
    .hero__pic { order: 0; min-height: 0; }
    .hero__pic :global(img) { object-position: 50% 72%; }
    .hero__text { align-content: start; gap: 10px; padding: 18px var(--gutter) 20px; }
    .hero__eyebrow { font-size: 0.72rem; }
    .hero h1 { font-size: clamp(2rem, 9.4vw, 3.6rem); }
    .hero__lead { font-size: 0.98rem; }
    .hero .cta { margin-top: 4px; }
    .hero .btn--xl { width: 100%; justify-content: center; }
    .hero__link, .hero__facts { display: none; }
    .histoire__grid, .anniv { grid-template-columns: minmax(0, 1fr); }
    .histoire__pic { aspect-ratio: 4 / 4.2; }
    .experience { grid-template-columns: minmax(0, 1fr); }
    .experience__pic { aspect-ratio: 4 / 3; }
  }
  @media (max-width: 860px) and (max-height: 620px) {
    /* Très petits écrans : on garde la photo, le titre et le bouton. */
    .hero { grid-template-rows: minmax(150px, 1fr) auto; }
    .hero__eyebrow, .hero__lead { display: none; }
    .hero__text { padding-block: 14px; }
    .hero h1 { font-size: 1.75rem; }
  }
  @media (max-width: 760px) {
    .grille, .formules { gap: 10px; }
    .grille > :global(:first-child) { grid-column: 1 / -1; }
    .formules { grid-template-columns: minmax(0, 1fr); }
    .formules > :global(:first-child) { grid-column: auto; }
  }
  @media (max-width: 520px) { .etapes, .experience__liste { grid-template-columns: minmax(0, 1fr); } }
</style>
