---
import Base from '../../layouts/Base.astro';
import WeekStrip from '../../components/WeekStrip.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { langPaths, t, path, colon, type Lang } from '../../i18n/ui';
import { contact, retrait, paiement, livraison, parcours, reponse } from '../../data/infos';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const fr = lang === 'fr';

const etapes = parcours;

const faq = [
  {
    q: { fr: 'Pourquoi ne pas commander le samedi même ?', ru: 'Почему нельзя заказать в субботу?' },
    r: { fr: 'On fait les courses le vendredi selon les commandes reçues. S’il reste des produits, on l’annonce dans notre statut WhatsApp le samedi matin.', ru: 'Продукты мы закупаем в пятницу под полученные заказы. Если что-то остаётся, пишем об этом в статусе WhatsApp в субботу утром.' },
  },
  {
    q: { fr: 'J’ai une allergie, que puis-je prendre ?', ru: 'У меня аллергия. Что мне можно?' },
    r: { fr: 'Les allergènes sont indiqués sur chaque fiche produit et sur chaque étiquette. Dites-le-nous avant de commander : tout est cuisiné dans la même cuisine, on vous dira honnêtement ce qui est possible.', ru: 'Аллергены указаны в описании каждого блюда и на каждой этикетке. Сообщите нам до заказа: всё готовится на одной кухне, и мы честно скажем, что вам подойдёт.' },
  },
  {
    q: { fr: 'Combien de temps ça se garde ?', ru: 'Сколько хранится?' },
    r: { fr: 'Crêpes et pastels : 2 jours au frais. Bissap : 3 jours. La date limite est écrite sur l’étiquette de chaque boîte.', ru: 'Блины и пастели — 2 дня в холодильнике, биссап — 3 дня. Срок годности написан на этикетке каждой коробки.' },
  },
  {
    q: { fr: 'Vous livrez ?', ru: 'Есть доставка?' },
    r: livraison,
  },
  {
    q: { fr: 'Vous faites des commandes pour une fête ?', ru: 'Можно заказать на праздник?' },
    r: { fr: 'Oui : gâteaux maison (dès 700 ₽) et box anniversaire composée par vous, à commander au moins 48 h à l’avance. Écrivez-nous la date, le nombre de personnes et ce que vous voulez, on vous donne le prix.', ru: 'Да: домашние кексы (от 700 ₽) и праздничный бокс, который вы собираете сами, — заказ минимум за 48 часов. Напишите дату, количество гостей и что хотите — мы назовём цену.' },
  },
  {
    q: { fr: 'Pourquoi payer au moment de la confirmation ?', ru: 'Почему оплата при подтверждении?' },
    r: { fr: 'On cuisine seulement ce qui est commandé, avec des produits achetés pour vous. Le virement valide la commande et nous permet de faire les courses le vendredi soir.', ru: 'Мы готовим только то, что заказано, из продуктов, купленных под ваш заказ. Перевод подтверждает заказ, и мы можем закупиться в пятницу вечером.' },
  },
  {
    q: { fr: 'J’ai commandé, quand est-ce qu’on me répond ?', ru: 'Я заказал(а). Когда мне ответят?' },
    r: reponse,
  },
];
---
<Base
  lang={lang}
  title={t(lang, 'nav.commander')}
  description={fr
    ? 'Commandez jusqu’au vendredi 20 h 30, payez par virement à la confirmation, récupérez le week-end devant la cité, Bezhitskaya 16 b à Briansk.'
    : 'Заказ до пятницы, 20:30, оплата переводом при подтверждении, выдача на выходных у общежития: ул. Бежицкая, 16Б, Брянск.'}
>
  <header class="wrap intro">
    <p class="eyebrow">{t(lang, 'nav.commander')}</p>
    <h1>{fr ? 'Commander chez Double Sestry, en 4 étapes.' : 'Как заказать в Double Sestry: 4 шага.'}</h1>
    <p class="lead">{fr ? 'Jusqu’au vendredi 20 h 30 pour le week-end. Gâteaux et box : au moins 48 h à l’avance.' : 'До пятницы, 20:30 — на выходные. Кексы и боксы — минимум за 48 часов.'}</p>
  </header>

  <section class="wrap">
    <ol class="steps">
      {etapes.map((e) => (
        <li><h2>{e.titre[lang]}</h2><p>{e.texte[lang]}</p></li>
      ))}
    </ol>
  </section>

  <section class="wrap grid2">
    <div class="card">
      <h2>{fr ? 'Retrait' : 'Получение'}</h2>
      <table class="slots">
        <tbody>
          {retrait.creneaux.map((c) => (
            <tr><th scope="row">{c.jour[lang]}</th><td>{c.heures.map((h) => <span>{h}</span>)}</td></tr>
          ))}
          <tr><th scope="row">{fr ? 'Où' : 'Где'}</th><td>{retrait.lieu[lang]}</td></tr>
        </tbody>
      </table>
      <a class="map" href="https://yandex.ru/maps/?text=%D0%91%D1%80%D1%8F%D0%BD%D1%81%D0%BA%2C%20%D1%83%D0%BB.%20%D0%91%D0%B5%D0%B6%D0%B8%D1%86%D0%BA%D0%B0%D1%8F%2C%2016%D0%91" target="_blank" rel="noopener">{fr ? 'Voir sur Yandex Maps' : 'Открыть в Яндекс Картах'} →</a>
    </div>
    <div class="card">
      <h2>{fr ? 'Nous écrire' : 'Написать нам'}</h2>
      <p class="muted">{fr ? 'Sur WhatsApp, en français ou en russe.' : 'В WhatsApp, по-русски или по-французски.'} {reponse[lang]}</p>
      <div class="num-row">
        <span class="num" id="phone">{contact.telephone}</span>
        <button type="button" class="copy" data-copy={`+${contact.whatsapp}`} data-done={fr ? 'Copié' : 'Скопировано'}>{fr ? 'Copier' : 'Копировать'}</button>
      </div>
      <WhatsAppButton lang={lang} />
      <dl class="pay">
        <div><dt>{fr ? 'Paiement' : 'Оплата'}{colon(lang)}</dt><dd>{paiement[lang]}</dd></div>
        <div><dt>{fr ? 'Livraison' : 'Доставка'}{colon(lang)}</dt><dd>{livraison[lang]}</dd></div>
      </dl>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="sub">{fr ? 'Notre semaine' : 'Наша неделя'}</h2>
    <WeekStrip lang={lang} />
  </section>

  <section class="wrap faq">
    <h2 class="sub">{fr ? 'Questions fréquentes' : 'Частые вопросы'}</h2>
    {faq.map((f) => (
      <details>
        <summary>{f.q[lang]}</summary>
        <p>{f.r[lang]}</p>
      </details>
    ))}
    <p class="back"><a href={path(lang, 'carte')}>{t(lang, 'cta.voirCarte')} →</a></p>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        btn.textContent = btn.dataset.done ?? 'OK';
      } catch {
        const el = document.getElementById('phone');
        if (el) getSelection()?.selectAllChildren(el);
      }
    });
  });
</script>

<style>
  .intro { display: grid; gap: var(--space-4); padding-block: var(--space-8) var(--space-6); }
  .intro h1 { max-width: 18ch; }
  .steps { list-style: none; counter-reset: s; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-4); }
  .steps li { counter-increment: s; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: var(--space-5); display: grid; gap: var(--space-2); align-content: start; min-width: 0; }
  .steps li::before {
    content: counter(s);
    display: grid;
    place-items: center;
    width: 36px;
    height: 41px;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    background: var(--miel);
    color: var(--on-miel);
    font-family: 'Young Serif', Georgia, serif;
    font-size: 1.1rem;
    margin-bottom: var(--space-2);
  }
  .steps h2 { font-size: var(--step-1); }
  .steps p { color: var(--muted); font-size: var(--step--1); }

  .grid2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); margin-top: var(--space-6); }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(18px, 3vw, 28px); display: grid; gap: var(--space-4); align-content: start; justify-items: start; min-width: 0; }
  .card h2 { font-size: var(--step-2); }
  .slots { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  .slots th { text-align: left; color: var(--choco); font-weight: 750; width: 36%; vertical-align: top; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .slots td { padding: 10px 0; border-bottom: 1px solid var(--line); }
  .slots td span { display: block; }
  .map { display: inline-block; margin-top: -6px; font-weight: 700; color: var(--choco); font-size: 0.9rem; }
  .slots tr:last-child th, .slots tr:last-child td { border-bottom: 0; }
  .muted { color: var(--muted); }
  .num-row { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; }
  .num { font-size: var(--step-2); font-weight: 750; color: var(--choco); font-variant-numeric: tabular-nums; user-select: all; }
  .copy { font: inherit; font-weight: 650; font-size: var(--step--1); padding: 6px 14px; border-radius: var(--radius-pill); border: 1.5px solid var(--line); background: transparent; color: var(--muted); cursor: pointer; }
  .pay { margin: 0; display: grid; gap: var(--space-3); font-size: var(--step--1); }
  .pay dt { font-weight: 750; color: var(--choco); }
  .pay dd { margin: 0; color: var(--muted); }

  .sub { font-size: var(--step-2); margin-bottom: var(--space-5); }
  .faq { max-width: 820px; }
  details { border-bottom: 1px solid var(--line); padding-block: var(--space-4); }
  summary { cursor: pointer; font-weight: 750; color: var(--choco); list-style: none; display: flex; justify-content: space-between; gap: var(--space-4); }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font-family: 'Young Serif', Georgia, serif; color: var(--miel-ink); font-size: 1.3rem; line-height: 1; }
  details[open] summary::after { content: '–'; }
  details p { margin-top: var(--space-2); color: var(--muted); max-width: 64ch; }
  .back { margin-top: var(--space-6); }
  .back a { font-weight: 750; color: var(--choco); text-decoration: none; }

  @media (max-width: 900px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 720px) { .grid2 { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 480px) { .steps { grid-template-columns: minmax(0, 1fr); } }
</style>
