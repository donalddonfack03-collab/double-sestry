---
import Base from '../../../layouts/Base.astro';
import Hex from '../../../components/Hex.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Prices from '../../../components/Prices.astro';
import Allergens from '../../../components/Allergens.astro';
import ProductCard from '../../../components/ProductCard.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
import { langs, t, path, colon, bang, type Lang, type UiKey } from '../../../i18n/ui';
import { enVente, trouver, type Produit } from '../../../data/produits';
import { contact, retrait, messageBox } from '../../../data/infos';
import { produit as produitSchema } from '../../../lib/schema';

export function getStaticPaths() {
  return langs.flatMap((lang) => enVente.map((p) => ({ params: { lang, slug: p.slug }, props: { p } })));
}
const photos = import.meta.glob<{ default: ImageMetadata }>('../../../assets/photos/*.{jpg,jpeg,png,webp}', { eager: true });
const lang = Astro.params.lang as Lang;
const { p } = Astro.props as { p: Produit };
const fr = lang === 'fr';

const categories: Record<Produit['categorie'], UiKey> = {
  sale: 'carte.sale', sucre: 'carte.sucre', boisson: 'carte.boisson', formule: 'carte.formule', surCommande: 'carte.surCommande',
};
const message = p.slug === 'box-anniversaire' ? messageBox[lang] : `${contact.messageParDefaut[lang]}${bang(lang)} ${fr ? 'Je voudrais commander' : 'Хочу заказать'}${colon(lang)} ${p.nom[lang]}`;
const inclus = (p.inclus ?? []).map(trouver).filter((x): x is Produit => !!x);
const dansFormules = enVente.filter((f) => f.inclus?.includes(p.slug));
const autres = enVente
  .filter((x) => x.slug !== p.slug && !inclus.includes(x) && !dansFormules.includes(x) && x.categorie !== 'surCommande')
  .sort((a, b) => Number(b.categorie === p.categorie) - Number(a.categorie === p.categorie))
  .slice(0, 2);
const photoSrc = p.photo ? photos[`../../../assets/photos/${p.photo}`]?.default : undefined;
const hexLabel = p.nom[lang].includes(':') ? p.nom[lang].split(':').pop()!.trim() : undefined;
---
<Base lang={lang} title={p.nom[lang]} ogType="product" jsonLd={produitSchema(p, lang, Astro.site!)} description={`${p.accroche[lang]}. ${p.description[lang]}`.slice(0, 158)}>
  <div class="wrap crumbs">
    <a href={path(lang, 'carte')}>{t(lang, 'nav.carte')}</a>
    <span aria-hidden="true">/</span>
    <span>{t(lang, categories[p.categorie])}</span>
  </div>

  <article class="wrap produit">
    <div class="visuel">
      {photoSrc ? (
        <div class="photo"><Image src={photoSrc} alt={p.photoAlt?.[lang] ?? ''} widths={[480, 720, 960]} sizes="(max-width: 820px) 100vw, 520px" loading="eager" fetchpriority="high" format="webp" quality={80} /></div>
      ) : (
        <Hex label={hexLabel} tone={p.categorie === 'formule' ? 'alveole' : 'miel'} width={440} loading="eager" />
      )}
    </div>
    <div class="infos">
      <div class="stack">
        <p class="eyebrow">{p.accroche[lang]}</p>
        <h1>{p.nom[lang]}</h1>
        <p class="desc">{p.description[lang]}</p>
      </div>
      {(p.surMesure || p.formats.every((f) => f.prix === null) || p.formats.some((f) => f.prixBarre)) && <Prices lang={lang} formats={p.formats} size="lg" depuis={p.surMesure} />}
      <div class="order">
        {!p.surMesure && p.formats.some((f) => f.prix !== null) ? (
          <div class="adds">
            {p.formats.map((f, i) => f.prix !== null && (
              <button class="addf" type="button" data-add={p.slug} data-f={i}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2.2l2.1 10.2a1.6 1.6 0 0 0 1.6 1.3h8.4a1.6 1.6 0 0 0 1.6-1.2L20.5 8H6.1" /><circle cx="10" cy="19.5" r="1.3" /><circle cx="17" cy="19.5" r="1.3" /></svg>
                <span>{fr ? 'Ajouter' : 'Добавить'} · {f.libelle[lang]}</span>
                <b>{f.prix} ₽</b>
              </button>
            ))}
          </div>
        ) : (
          <WhatsAppButton lang={lang} message={message} />
        )}
        <p class="hint">
          {p.categorie === 'surCommande'
            ? (fr ? 'À commander au moins 48 h à l’avance.' : 'Заказывайте минимум за 48 часов.')
            : (fr ? `Commande jusqu’au ${retrait.finCommandes.fr}, retrait le week-end.` : `Заказ до ${retrait.finCommandes.ru}, выдача на выходных.`)}
        </p>
      </div>
      {inclus.length > 0 && (
        <div class="inclus">
          <h2>{fr ? 'Dans la formule' : 'В наборе'}</h2>
          <ul>{inclus.map((x) => <li><a href={path(lang, `carte/${x.slug}`)}>{x.nom[lang]}</a></li>)}</ul>
        </div>
      )}
      <Allergens lang={lang} produit={p} />
      {dansFormules.length > 0 && (
        <p class="formules">
          {fr ? 'Aussi dans' : 'Также в'}{colon(lang)}{' '}
          {dansFormules.map((f, i) => <>{i > 0 && ', '}<a href={path(lang, `carte/${f.slug}`)}>{f.nom[lang]}</a></>)}
        </p>
      )}
    </div>
  </article>

  {autres.length > 0 && (
    <section class="wrap section more">
      <h2>{fr ? 'Avec ça ?' : 'Что-нибудь ещё?'}</h2>
      <div class="grid">{autres.map((x) => <ProductCard lang={lang} produit={x} />)}</div>
      <a class="link" href={path(lang, 'carte')}>{t(lang, 'produit.retourCarte')}</a>
    </section>
  )}
</Base>

<style>
  .crumbs { display: flex; gap: var(--space-2); padding-top: var(--space-5); font-size: var(--step--1); color: var(--muted); }
  .crumbs a { color: var(--choco); font-weight: 650; text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .produit {
    display: grid;
    grid-template-columns: minmax(0, 520px) minmax(0, 1fr);
    gap: clamp(28px, 6vw, 80px);
    align-items: start;
    padding-block: var(--space-6) var(--space-7);
  }
  .visuel { position: sticky; top: 90px; }
  .photo { aspect-ratio: 4 / 5; border-radius: 18px; overflow: hidden; background: var(--alveole); }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .infos { display: grid; gap: var(--space-6); min-width: 0; max-width: 60ch; }
  .desc { font-size: var(--step-1); line-height: 1.55; color: var(--ink); }
  .order { display: grid; gap: var(--space-2); justify-items: start; }
  .adds { display: flex; flex-wrap: wrap; gap: 10px; }
  .addf {
    display: inline-flex; align-items: center; gap: 9px;
    background: var(--choco); color: var(--on-choco); border: 0; cursor: pointer;
    font: inherit; font-weight: 700; padding: 12px 18px; border-radius: 999px; transition: background-color 0.15s;
  }
  .addf:hover { background: var(--miel); color: var(--on-miel); }
  .addf svg { width: 19px; height: 19px; }
  .addf b { font-weight: 850; padding-left: 9px; border-left: 1px solid currentColor; }
  .addf:global(.pop) { animation: pop 0.35s ease; }
  @keyframes pop { 40% { transform: scale(1.06); } }
  .hint { color: var(--muted); font-size: var(--step--1); }
  .inclus h2 { font-size: var(--step-1); margin-bottom: var(--space-2); }
  .inclus ul { margin: 0; padding-left: 1.1em; display: grid; gap: 4px; }
  .inclus a, .formules a { color: var(--choco); font-weight: 650; }
  .formules { font-size: var(--step--1); color: var(--muted); }
  .more h2 { font-size: var(--step-2); margin-bottom: var(--space-5); }
  .more .grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-4); margin-bottom: var(--space-5); }
  .link { font-weight: 750; color: var(--choco); text-decoration: none; }
  @media (max-width: 820px) {
    .produit { grid-template-columns: minmax(0, 1fr); }
    .visuel { position: static; }
    .photo { aspect-ratio: 4 / 3.6; }
    .visuel :global(.hex) { max-width: 260px; }
    .more .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
